<%- include('../partials/header') %>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-logo">
      <i class="fa-solid fa-film text-accent"></i> I<span>Movies</span>
      <div style="font-size: 0.72rem; color: var(--text-muted); font-weight: 500; margin-top: 4px;">MANAGEMENT PORTAL</div>
    </div>
    <a href="/admin" class="admin-link">
      <i class="fa-solid fa-chart-line"></i> Dashboard
    </a>
    <a href="/admin/movies" class="admin-link">
      <i class="fa-solid fa-film"></i> Movies Catalog
    </a>
    <a href="/admin/movies/new" class="admin-link active">
      <i class="fa-solid fa-plus"></i> Add New Movie
    </a>
    <div style="margin-top: auto; padding-top: 20px; border-top: 1px solid var(--border);">
      <a href="/" class="admin-link">
        <i class="fa-solid fa-globe"></i> View Live Site
      </a>
      <a href="/logout" class="admin-link" style="color: #e74c3c;">
        <i class="fa-solid fa-arrow-right-from-bracket"></i> Sign Out
      </a>
    </div>
  </aside>

  <main class="admin-main">
    <div class="admin-header">
      <a href="/admin/movies" class="btn btn-ghost btn-sm" style="margin-bottom: 12px;">
        <i class="fa-solid fa-arrow-left"></i> Back to Catalog
      </a>
      <h1>Add Movie to Repertoire</h1>
      <p>Configure screening assets, metadata, media links, and projection formats.</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error" style="max-width: 720px; margin-bottom: 24px;">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <div style="background: var(--bg-card); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 36px; max-width: 720px;">
      <form action="/admin/movies/new" method="POST">
        <div class="form-group">
          <label class="form-label" for="title">Movie Title *</label>
          <input type="text" id="title" name="title" value="<%= (movie && movie.title) || '' %>" class="form-input" placeholder="e.g. Dune: Part Two" required>
        </div>

        <div class="form-group">
          <label class="form-label" for="description">Synopsis / Description *</label>
          <textarea id="description" name="description" class="form-input" rows="4" placeholder="Compelling summary of the film storyline..." required><%= (movie && movie.description) || '' %></textarea>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
          <div class="form-group">
            <label class="form-label" for="duration">Duration (Minutes) *</label>
            <input type="number" id="duration" name="duration" value="<%= (movie && movie.duration) || '145' %>" min="30" max="360" class="form-input" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="releaseDate">Release Date *</label>
            <input type="date" id="releaseDate" name="releaseDate" value="<%= (movie && movie.releaseDate) ? new Date(movie.releaseDate).toISOString().split('T')[0] : '2026-10-20' %>" class="form-input" required>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
          <div class="form-group">
            <label class="form-label" for="genre">Genres (comma separated) *</label>
            <input type="text" id="genre" name="genre" value="<%= (movie && movie.genre) || 'Action, Sci-Fi, Adventure' %>" class="form-input" placeholder="Sci-Fi, Adventure" required>
          </div>

          <div class="form-group">
            <label class="form-label" for="language">Languages (comma separated) *</label>
            <input type="text" id="language" name="language" value="<%= (movie && movie.language) || 'English' %>" class="form-input" placeholder="English, Spanish" required>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px;">
          <div class="form-group">
            <label class="form-label" for="imdbRating">IMDb Rating (1.0 to 10.0)</label>
            <input type="number" step="0.1" id="imdbRating" name="imdbRating" value="<%= (movie && movie.imdbRating) || '8.5' %>" min="1.0" max="10.0" class="form-input">
          </div>

          <div class="form-group">
            <label class="form-label" for="status">Catalog Status</label>
            <select id="status" name="status" class="form-input">
              <option value="now_showing" <%= (movie && movie.status === 'now_showing') ? 'selected' : '' %>>Now Showing</option>
              <option value="upcoming" <%= (movie && movie.status === 'upcoming') ? 'selected' : '' %>>Coming Soon (Upcoming)</option>
            </select>
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="formats">Formats (comma separated)</label>
          <input type="text" id="formats" name="formats" value="<%= (movie && movie.formats) || '2D, 3D, IMAX' %>" class="form-input" placeholder="2D, 3D, IMAX, 4DX">
        </div>

        <div class="form-group">
          <label class="form-label" for="posterUrl">Poster Image URL</label>
          <input type="url" id="posterUrl" name="posterUrl" value="<%= (movie && movie.posterUrl) || 'https://images.unsplash.com/photo-1536440136628-849c177e76a1?w=800&auto=format&fit=crop&q=80' %>" class="form-input" placeholder="https://image-url.com/poster.jpg">
        </div>

        <div class="form-group">
          <label class="form-label" for="trailerUrl">YouTube Trailer URL</label>
          <input type="url" id="trailerUrl" name="trailerUrl" value="<%= (movie && movie.trailerUrl) || 'https://www.youtube.com' %>" class="form-input" placeholder="https://www.youtube.com/watch?v=...">
        </div>

        <div style="display: flex; gap: 12px; margin-top: 32px;">
          <button type="submit" class="btn btn-primary btn-lg">
            <i class="fa-solid fa-cloud-arrow-up"></i> Save &amp; Publish Movie
          </button>
          <a href="/admin/movies" class="btn btn-outline btn-lg">Cancel</a>
        </div>
      </form>
    </div>
  </main>
</div>

<script src="/js/main.js"></script>
</body>
</html>
