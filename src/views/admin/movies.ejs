<%- include('../partials/header') %>

<div class="admin-layout">
  <aside class="admin-sidebar">
    <div class="admin-logo">
      <i class="fa-solid fa-film text-accent"></i> I<span>Movies</span>
      <div style="font-size: 0.72rem; color: var(--text-muted); font-weight: 500; margin-top: 4px;">MANAGEMENT PORTAL</div>
    </div>
    <a href="/admin" class="admin-link">
      <i class="fa-solid fa-chart-line"></i> Dashboard
    </a>
    <a href="/admin/movies" class="admin-link active">
      <i class="fa-solid fa-film"></i> Movies Catalog
    </a>
    <a href="/admin/movies/new" class="admin-link">
      <i class="fa-solid fa-plus"></i> Add New Movie
    </a>
    <div style="margin-top: auto; padding-top: 20px; border-top: 1px solid var(--border);">
      <a href="/" class="admin-link">
        <i class="fa-solid fa-globe"></i> View Live Site
      </a>
      <a href="/logout" class="admin-link" style="color: #e74c3c;">
        <i class="fa-solid fa-arrow-right-from-bracket"></i> Sign Out
      </a>
    </div>
  </aside>

  <main class="admin-main">
    <div class="admin-header" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 16px;">
      <div>
        <h1>Manage Cinema Catalog</h1>
        <p>Review titles, adjust screening status, add new films or decommission listings.</p>
      </div>
      <div>
        <a href="/admin/movies/new" class="btn btn-primary">
          <i class="fa-solid fa-plus"></i> Add New Movie
        </a>
      </div>
    </div>

    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th>Movie</th>
            <th>Genre</th>
            <th>Duration</th>
            <th>Rating</th>
            <th>Formats</th>
            <th>Status</th>
            <th>Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (movies && movies.length > 0) { %>
            <% movies.forEach(m => { %>
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 12px;">
                    <% if (m.posterUrl) { %>
                      <img src="<%= m.posterUrl %>" alt="" style="width: 38px; height: 52px; object-fit: cover; border-radius: 4px;" onerror="this.style.display='none';">
                    <% } %>
                    <div>
                      <div style="font-weight: 700;"><%= m.title %></div>
                      <div style="font-size: 0.75rem; color: var(--text-muted);"><%= m.language ? m.language.join(', ') : 'English' %></div>
                    </div>
                  </div>
                </td>
                <td><%= m.genre ? m.genre.slice(0, 2).join(', ') : '—' %></td>
                <td><%= m.duration %> min</td>
                <td style="color: var(--gold); font-weight: 700;"><i class="fa-solid fa-star"></i> <%= (m.rating && m.rating.imdb) || '8.0' %></td>
                <td><%= m.formats ? m.formats.join(', ') : '2D' %></td>
                <td>
                  <span class="movie-badge <%= m.status === 'now_showing' ? 'badge-showing' : 'badge-upcoming' %>" style="position: static;">
                    <%= m.status === 'now_showing' ? 'Showing' : 'Upcoming' %>
                  </span>
                </td>
                <td>
                  <div style="display: flex; gap: 8px;">
                    <a href="/movies/<%= m._id %>" class="btn btn-outline btn-sm" target="_blank" title="View Detail Page">
                      <i class="fa-solid fa-arrow-up-right-from-square"></i>
                    </a>
                    <form action="/admin/movies/<%= m._id %>/delete" method="POST" onsubmit="return confirm('Are you sure you want to deactivate <%= m.title %>?')">
                      <button type="submit" class="btn btn-ghost btn-sm" style="color: #e74c3c;" title="Deactivate Movie">
                        <i class="fa-solid fa-trash-can"></i>
                      </button>
                    </form>
                  </div>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="7" style="text-align: center; padding: 40px; color: var(--text-muted);">
                No movies found in database. Click "Add New Movie" above.
              </td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </main>
</div>

<script src="/js/main.js"></script>
</body>
</html>
