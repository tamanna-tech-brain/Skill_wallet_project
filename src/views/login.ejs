<%- include('partials/header') %>
<%- include('partials/navbar') %>

<main class="container" style="padding: 60px 0;">
  <div class="form-card fade-up">
    <div style="text-align: center; margin-bottom: 24px;">
      <i class="fa-solid fa-film text-accent" style="font-size: 2.2rem; margin-bottom: 12px;"></i>
      <h1 class="form-title">Welcome Back</h1>
      <p class="form-subtitle">Sign in to your IMovies account to access bookings and seat passes.</p>
    </div>

    <% if (error) { %>
      <div class="alert alert-error">
        <i class="fa-solid fa-circle-exclamation"></i>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/login" method="POST" id="loginForm">
      <input type="hidden" name="redirect" value="<%= redirect %>">

      <div class="form-group">
        <label class="form-label" for="email">Email Address</label>
        <input type="email" id="email" name="email" class="form-input" placeholder="you@example.com" required autocomplete="email">
      </div>

      <div class="form-group">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <label class="form-label" for="password" style="margin-bottom: 0;">Password</label>
        </div>
        <input type="password" id="password" name="password" class="form-input" placeholder="••••••••" required autocomplete="current-password">
      </div>

      <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top: 10px;">
        <i class="fa-solid fa-arrow-right-to-bracket"></i> Sign In
      </button>
    </form>

    <div class="form-divider">OR</div>

    <div style="text-align: center; font-size: 0.9rem; color: var(--text-secondary);">
      Don't have an account? <a href="/register" style="color: var(--accent); font-weight: 700;">Create one now</a>
    </div>

    <div style="margin-top: 24px; padding: 12px; background: rgba(255,255,255,0.03); border: 1px dashed var(--border); border-radius: 8px; font-size: 0.78rem; color: var(--text-muted); text-align: center;">
      <strong>Demo Admin:</strong> admin@imovies.com • Pass: Admin@12345<br>
      <strong>Demo User:</strong> user@imovies.com • Pass: User@12345
    </div>
  </div>
</main>

<%- include('partials/footer') %>
